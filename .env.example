# Copy to .env and adjust. Every setting is read from the environment with the HAI_ prefix
# (see packages/hai-core/src/hai_core/settings.py). Values here are development defaults.

# --- Environment -------------------------------------------------------------
# development | test | production. Production refuses dev- secrets, secrets under 32 chars and HAI_AUTH_DISABLED.
HAI_ENV=development
HAI_SERVICE_NAME=hai
HAI_LOG_LEVEL=INFO
HAI_LOG_JSON=true

# --- Database ----------------------------------------------------------------
HAI_DATABASE_URL=postgresql://hai:hai@localhost:5432/hai
# SET LOCAL ROLE to the component's database role in every transaction (hai_pipeline, hai_engine, ...).
HAI_ENFORCE_DB_ROLES=true
HAI_MIGRATIONS_DIR=db/migrations
# Admin URL used by the test suite to create a throwaway database per session.
HAI_TEST_DATABASE_URL=postgresql://hai:hai@localhost:5432/postgres

# --- Compose only (docker-compose.yml) ---------------------------------------
POSTGRES_USER=hai
POSTGRES_PASSWORD=hai
POSTGRES_DB=hai
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=8080

# --- Auth and signing (replace all four in production; 32+ characters) -------
HAI_AUTH_DISABLED=false
HAI_API_KEY_PEPPER=dev-api-key-pepper-not-for-production-0001
HAI_JWT_SECRET=dev-jwt-secret-not-for-production-00000001
HAI_JWT_ISSUER=hai
HAI_JWT_TTL_MINUTES=480
HAI_CERT_SIGNING_KEY=dev-cert-signing-key-not-for-production-01
HAI_WEBHOOK_SIGNING_KEY=dev-webhook-signing-key-not-for-prod-0001

# --- Storage -----------------------------------------------------------------
# fsspec URL for raw document text: file://, s3://, gs://, az://
HAI_BLOB_STORE_URL=file://./var/blobs

# --- Ontology and connectors -------------------------------------------------
# Leave empty to find ontology/ above the working directory.
HAI_ONTOLOGY_DIR=
HAI_CONNECTORS_CONFIG=config/connectors.yaml

# --- API ---------------------------------------------------------------------
HAI_PUBLIC_BASE_URL=http://localhost:8000
HAI_API_HOST=0.0.0.0
HAI_API_PORT=8000
# JSON list of exact origins; origins ending in one of the suffixes are also allowed.
HAI_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
HAI_CORS_ORIGIN_SUFFIXES=[".humaital.com",".humanalignmentindex.com"]

# --- LLM providers -----------------------------------------------------------
# heuristic (offline, follows the evidence ladder) | openai | anthropic | ollama
HAI_LLM_PROVIDER=heuristic
HAI_LLM_MODEL=ladder-1
# openai: https://api.openai.com/v1 (or any OpenAI-compatible server); anthropic: https://api.anthropic.com;
# ollama: http://localhost:11434 (http://ollama:11434 under compose with the ollama profile)
HAI_LLM_BASE_URL=
HAI_LLM_API_KEY=
HAI_LLM_TIMEOUT_SECONDS=60
# Optional second opinion for borderline findings.
HAI_LLM_SECOND_OPINION_PROVIDER=
HAI_LLM_SECOND_OPINION_MODEL=
HAI_PROMPT_VERSION=1.0.0

# --- HTTP fetching -----------------------------------------------------------
HAI_HTTP_USER_AGENT=HAI-Assessment-Bot/2.0 (+https://humanalignmentindex.com)
HAI_HTTP_TIMEOUT_SECONDS=15
HAI_HTTP_TOTAL_BUDGET_SECONDS=120
HAI_HTTP_PAGE_BUDGET=60
HAI_HTTP_MIN_INTERVAL_SECONDS=0.5
HAI_HTTP_MAX_RETRIES=2

# --- Worker ------------------------------------------------------------------
HAI_WORKER_POLL_SECONDS=2
HAI_WORKER_LEASE_SECONDS=180
HAI_WORKER_ID=worker-1
HAI_MONITORING_TICK_MINUTES=60

# --- Frontend build (Vite) ---------------------------------------------------
# Empty means same origin (nginx proxies /v1 to API_UPSTREAM). Set for a split deployment.
VITE_API_BASE=
