      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-08",
      "rdfs:comment": "A link contributes only to the criterion_code it names. No cross-criterion or global promotion.",
      "hai:enforcedIn": "rules_engine",
      "hai:acceptanceTest": "AT-02"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-09",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-09",
      "rdfs:comment": "Documents in one source cluster count once for independence and confidence.",
      "hai:enforcedIn": "rules_engine",
      "hai:acceptanceTest": "AT-07"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-10",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-10",
      "rdfs:comment": "One canonical incident per canonical_event_key; at most one score adjustment per incident per assessment.",
      "hai:enforcedIn": "db_unique",
      "hai:acceptanceTest": "AT-04"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-11",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-11",
      "rdfs:comment": "Incidents in alleged or under_investigation create a review, never an automatic adjustment.",
      "hai:enforcedIn": "rules_engine",
      "hai:acceptanceTest": "AT-05"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-12",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-12",
      "rdfs:comment": "criterion_decisions, assessment_results and certification_decisions are writable only by the rules-engine and reviewer roles.",
      "hai:enforcedIn": "db_grants",
      "hai:acceptanceTest": "AT-10"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-13",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-13",
      "rdfs:comment": "hai_certified requires a signed certification_decisions row with a reviewer.",
      "hai:enforcedIn": "db_trigger",
      "hai:acceptanceTest": "AT-10"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-14",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-14",
      "rdfs:comment": "Every criterion_decision lists at least one applied rule code.",
      "hai:enforcedIn": "db_check",
      "hai:acceptanceTest": "AT-12"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-15",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-15",
      "rdfs:comment": "coverage_state unavailable requires at least one failed or blocked connector_run.",
      "hai:enforcedIn": "rules_engine",
      "hai:acceptanceTest": "AT-11"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-16",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-16",
      "rdfs:comment": "No source may be reported as collected unless a connector_run with succeeded exists for it.",
      "hai:enforcedIn": "report_generator",
      "hai:acceptanceTest": "AT-11"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-17",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-17",
      "rdfs:comment": "Crawled text is stored as data only and never concatenated into system instructions.",
      "hai:enforcedIn": "evaluation_worker",
      "hai:acceptanceTest": "AT-15"
    },
    {
      "@id": "https://humaital.com/ontology/hai#ic/IC-18",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-18",
      "rdfs:comment": "Each assessment pins ontology, methodology, ruleset, prompt and model versions; none may be null.",
      "hai:enforcedIn": "db_not_null",
      "hai:acceptanceTest": "AT-07"
    }
  ]
}
