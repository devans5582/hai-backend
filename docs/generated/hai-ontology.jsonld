      },
      "skos:notation": "not_tested",
      "skos:prefLabel": "Not tested",
      "skos:definition": "A control exists but no execution evidence.",
      "hai:attributes": {
        "counts_in_score": true,
        "report_wording": "A control is documented but its operation is unconfirmed.",
        "routes_to_review": false
      }
    },
    {
      "@id": "https://humaital.com/ontology/hai#vocab/coverage_state/failed",
      "@type": "skos:Concept",
      "skos:inScheme": {
