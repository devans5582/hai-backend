      "skos:definition": "Sources could not be reached (blocked, rate limited, outage). Requires a failed or blocked connector run (IC-15).",
      "hai:attributes": {
        "counts_in_score": false,
        "report_wording": "Sources could not be reached. This is an access limitation, not a governance gap. Excluded from the score.",
        "routes_to_review": false
      }
    },
    {
      "@id": "https://humaital.com/ontology/hai#vocab/coverage_state/not_applicable",
      "@type": "skos:Concept",
      "skos:inScheme": {
