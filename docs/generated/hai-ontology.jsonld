      "skos:prefLabel": "Not applicable",
      "skos:definition": "The criterion does not apply under an explicit applicability rule.",
      "hai:attributes": {
        "counts_in_score": false,
        "report_wording": "This criterion does not apply to the organization under the stated rule. Excluded from the score.",
        "routes_to_review": false
      }
    },
    {
      "@id": "https://humaital.com/ontology/hai#vocab/coverage_state/not_tested",
      "@type": "skos:Concept",
      "skos:inScheme": {
