      "@id": "https://humaital.com/ontology/hai#ic/IC-05",
      "@type": "hai:IntegrityConstraint",
      "rdfs:label": "IC-05",
      "rdfs:comment": "A finding with a missing or unknown criterion_code, or no citations for a proposed level above 1, is rejected.",
